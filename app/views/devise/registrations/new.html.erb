<div class="flex items-center justify-center">
  <div class="w-full max-w-md bg-white rounded-lg shadow-md p-6">
    <h2 class="text-2xl font-semibold mb-6 text-center">Sign Up</h2>

    <%= form_with model: resource, url: registration_path(resource_name), local: true, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, class: "block mb-1 text-sm font-medium" %>
        <%= f.email_field :email, autofocus: true, class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :password, class: "block mb-1 text-sm font-medium" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block mb-1 text-sm font-medium" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.submit "Sign Up", class: "w-full bg-green-600 text-white py-2 px-4 rounded hover:bg-green-700" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= link_to "Log in", new_session_path(resource_name), class: "text-sm text-gray-600 hover:underline" %>
    </div>
  </div>
</div>
