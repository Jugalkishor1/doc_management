<h1>Data Entry Operator Dashboard</h1>

<h2>Clients</h2>
<ul>
  <% @clients.each do |client| %>
    <li><%= client.email %></li>
  <% end %>
</ul>

<h2>Documents</h2>
<ul>
  <% @documents.each do |doc| %>
    <li>
      <%= doc.file.filename %> - <%= doc.status %>
      <% if doc.status == "uploaded" %>
        <%= link_to 'Verify', verify_data_entry_operator_document_path(doc), data: { "turbo-method": :patch } %>
      <% end %>
    </li>
  <% end %>
</ul>
