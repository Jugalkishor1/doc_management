<div class="max-w-xl mx-auto px-4 py-8 bg-white shadow rounded">
  <h1 class="text-2xl font-bold mb-6">Upload New Document</h1>

  <%= form_with model: [:client, @document], local: true, class: "space-y-6" do |form| %>
    <div>
      <%= form.label :file, class: "block text-gray-700 font-medium mb-1" %>
      <%= form.file_field :file, class: "w-full border border-gray-300 p-2 rounded" %>
    </div>

    <div>
      <%= form.submit "Upload", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded" %>
    </div>
  <% end %>
</div>
