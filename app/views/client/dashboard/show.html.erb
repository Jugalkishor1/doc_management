<div class="max-w-4xl mx-auto p-6 bg-white shadow-md rounded-lg">
  <h1 class="text-2xl font-bold text-gray-800 mb-4">Client Dashboard</h1>

  <div class="mb-6">
    <h2 class="text-xl font-semibold text-gray-700 mb-2">Client Information</h2>
    <p><span class="font-semibold text-gray-600">Email:</span> <%= @client.email %></p>
    <p><span class="font-semibold text-gray-600">Manager:</span> <%= @client.manager&.email || 'Not Assigned' %></p>
    <p><span class="font-semibold text-gray-600">Supervisor:</span> <%= @client.supervisor&.email || 'Not Assigned' %></p>
    <p><span class="font-semibold text-gray-600">Data Entry Operator:</span> <%= @client.data_entry_operator&.email || 'Not Assigned' %></p>
  </div>

  <div>
    <h2 class="text-xl font-semibold text-gray-700 mb-2">Uploaded Documents</h2>
    <% if @client.documents.any? %>
      <table class="min-w-full bg-white border rounded shadow">
        <thead class="bg-gray-200 text-left text-gray-700">
          <tr>
            <th class="px-4 py-2">File</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2">Uploaded At</th>
          </tr>
        </thead>
        <tbody>
          <% @client.documents.each do |doc| %>
            <tr class="border-t">
              <td class="px-4 py-2">
                <%= link_to doc.file.filename, url_for(doc.file), class: "text-blue-600 underline", target: "_blank" %>
              </td>
              <td class="px-4 py-2"><%= doc.status.humanize %></td>
              <td class="px-4 py-2"><%= doc.created_at.strftime("%d %b %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-600 italic">No documents uploaded yet.</p>
    <% end %>
  </div>
</div>
